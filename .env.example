# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Atlas connection string. Automated Embedding needs an M10+ dedicated cluster
# with storage auto-scaling enabled; see CAIRN_EMBED_BACKEND below for the
# fallbacks if you are on a smaller tier.
MONGODB_URI=

# Hermes needs one of these. OpenRouter is what the hackathon hands out credits
# for; OPENAI_API_KEY / ANTHROPIC_API_KEY also work for direct provider access.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------

# atlas  -- Atlas Automated Embedding (default, recommended). Documents store
#           text; Atlas generates and maintains the vectors server-side. No
#           embedding pipeline and no second API key. Requires M10+.
# voyage -- client-side embeddings; requires VOYAGE_API_KEY below.
# hash   -- deterministic local fallback, no network, no key. Lexical
#           similarity only: measured 0.507 on a near-duplicate pair, well
#           below any useful threshold, so semantic dedupe will not fire.
#           Fine for a smoke test, not for a real run.
CAIRN_EMBED_BACKEND=atlas

# Server-side model for autoEmbed. Options: voyage-4-lite, voyage-4,
# voyage-4-large, voyage-code-3.
CAIRN_AUTOEMBED_MODEL=voyage-4

# Only used when CAIRN_EMBED_BACKEND=voyage.
VOYAGE_API_KEY=
CAIRN_EMBED_MODEL=voyage-3.5
CAIRN_EMBED_DIMS=1024

# ---------------------------------------------------------------------------
# Model routing -- one tier per role
# ---------------------------------------------------------------------------

# SCOUT runs once per run but must emit a long structured list. Reasoning-only
# models (e.g. gpt-oss-120b) reliably return no visible content for this shape
# of task, which silently yields zero candidates.
CAIRN_SCOUT_MODEL=anthropic/claude-sonnet-4.6

# GRADER runs N times per run and is the dominant cost. It still has to emit
# visible JSON every time: gpt-oss-120b returned reasoning-only responses on
# roughly a quarter of calls, storing garbage as a durable verdict.
CAIRN_VERDICT_MODEL=anthropic/claude-haiku-4.5

# BRIEFER and RULEMAKER are low-volume and judgement-heavy. A bad induced rule
# poisons every future run, so this is the worst place to economise.
CAIRN_BRIEF_MODEL=anthropic/claude-sonnet-4.6
CAIRN_RULE_MODEL=anthropic/claude-sonnet-4.6

# ---------------------------------------------------------------------------
# Memory gate thresholds
# ---------------------------------------------------------------------------
# Calibrated against voyage-4 via autoEmbed, which normalises scores into
# roughly 0.55 (unrelated) .. 0.90 (identical). Measured separation:
#   dup      0.825 same-intent must veto  / 0.733 new topic must pass
#   verdict  0.840 same intent must reuse / 0.712 same-shape-different-topic
#   rule     0.636 should fire            / 0.570 should not  <- thinnest margin
# Re-calibrate if you change the embedding model; a threshold set above the
# must-fire score disables that check silently.
CAIRN_DUP_THRESHOLD=0.80
CAIRN_VERDICT_THRESHOLD=0.82
CAIRN_RULE_THRESHOLD=0.62

# Atlas Search (BM25) half of cannibalization detection. Searches targetKeyword
# only -- including title/h1 let long queries pile up common-token matches and
# a false positive outscored a true one (6.08 vs 5.65). On targetKeyword the
# same pair separates: 2.34 false / 3.07 true.
CAIRN_KEYWORD_THRESHOLD=2.8

# Rule-based vetoing is OFF by default, on evidence. Matching a category
# sentence against a short query does not separate cleanly: measured true
# positives scored 0.636-0.661, but a verified false positive scored 0.730 --
# higher than any true positive, so no threshold can split them. Rules are used
# to steer SCOUT instead, where the same data is unambiguous. Set true to
# re-enable the third gate.
CAIRN_RULE_VETO=false

# ---------------------------------------------------------------------------
# Run shape
# ---------------------------------------------------------------------------
CAIRN_DB=cairn
CAIRN_MAX_PAGES=60
CAIRN_CANDIDATES=12
CAIRN_VERDICT_WORKERS=4
