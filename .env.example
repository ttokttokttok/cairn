# --- required ---------------------------------------------------------------
# Atlas connection string from your hackathon sandbox cluster.
MONGODB_URI=

# Hermes needs one of these. OpenRouter is what the hackathon hands out credits for.
OPENROUTER_API_KEY=

# --- optional ---------------------------------------------------------------
# Embedding backend:
#   atlas  -- Atlas Automated Embedding (default). Atlas generates and maintains
#             the vectors server-side. NO extra API key. Needs an M10+ cluster.
#   voyage -- client-side embeddings; requires VOYAGE_API_KEY below.
#   hash   -- deterministic local fallback, lexical similarity only.
CAIRN_EMBED_BACKEND=atlas
CAIRN_AUTOEMBED_MODEL=voyage-4

# Only needed when CAIRN_EMBED_BACKEND=voyage.
VOYAGE_API_KEY=

CAIRN_DB=cairn
CAIRN_VERDICT_MODEL=openai/gpt-oss-120b
CAIRN_BRIEF_MODEL=anthropic/claude-sonnet-4.6
CAIRN_MAX_PAGES=60
CAIRN_CANDIDATES=12
CAIRN_VERDICT_WORKERS=4
