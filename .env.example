# --- required ---------------------------------------------------------------
# Atlas connection string from your hackathon sandbox cluster.
MONGODB_URI=

# Hermes needs one of these. OpenRouter is what the hackathon hands out credits for.
OPENROUTER_API_KEY=

# --- optional ---------------------------------------------------------------
# Voyage AI (MongoDB's embedding models). Without it cairn falls back to a
# deterministic hashed bag-of-words: lexical similarity only, no network needed.
VOYAGE_API_KEY=

CAIRN_DB=cairn
CAIRN_VERDICT_MODEL=openai/gpt-oss-120b
CAIRN_BRIEF_MODEL=anthropic/claude-sonnet-4.6
CAIRN_EMBED_BACKEND=auto
CAIRN_MAX_PAGES=60
CAIRN_CANDIDATES=12
CAIRN_VERDICT_WORKERS=4
